options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: 'Stage 1-3 coherent FX engine only. RX0=Antenna 0 / 2.4 m, RX1=Antenna
      1 / 1.7 m. Cross-spectrum convention: C01[k] = X0[k] * conj(X1[k]). High-side
      LNB sky axis uses x_start=lnb_lo-(if_cf-samp_rate/2), x_step=-samp_rate/fft_size.'
    copyright: ''
    description: Minimal two-channel B210 FX correlator commissioning flowgraph.
    gen_cmake: 'Off'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: fx_interferometer_v1_stage1_3
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: FX Interferometer V1 Stage 1-3
    window_size: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [56, 80.0]
    enabled: true
    rotation: 0
    state: enabled

blocks:
- name: accum_frames
  id: variable
  parameters:
    comment: 'At defaults: round(7500*0.1) = 750 FFT vectors.'
    value: int(round(fft_rate*accum_time))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1552, 1200.0]
    enabled: true
    rotation: 0
    state: enabled
- name: accum_time
  id: variable
  parameters:
    comment: First-stage accumulation time in seconds.
    value: '0.1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [776, 1632.0]
    enabled: true
    rotation: 0
    state: enabled
- name: fft_rate
  id: variable
  parameters:
    comment: 'At defaults: 30.72e6/4096 = 7500 FFT vectors/s.'
    value: samp_rate/fft_size
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1560, 1304.0]
    enabled: true
    rotation: 0
    state: enabled
- name: fft_size
  id: variable
  parameters:
    comment: Default FFT length. Stage 1-3 default is 4096.
    value: '4096'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1208, 1688.0]
    enabled: true
    rotation: 0
    state: enabled
- name: gain0
  id: variable
  parameters:
    comment: RX0 / antenna 0 / 2.4 m commissioning gain, dB.
    value: '40'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [360, 1000.0]
    enabled: true
    rotation: 0
    state: enabled
- name: gain1
  id: variable
  parameters:
    comment: RX1 / antenna 1 / 1.7 m commissioning gain, dB.
    value: '40'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [352, 1112.0]
    enabled: true
    rotation: 0
    state: enabled
- name: if_cf
  id: variable
  parameters:
    comment: 'Nominal B210 IF centre frequency: lnb_lo - sky_cf = 1.150 GHz.'
    value: lnb_lo-sky_cf
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [352, 1320.0]
    enabled: true
    rotation: 0
    state: enabled
- name: lnb_lo
  id: variable
  parameters:
    comment: High-side LNB local oscillator, Hz.
    value: 5.950e9
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [352, 1440.0]
    enabled: true
    rotation: 0
    state: enabled
- name: manual_dec_deg
  id: variable_qtgui_entry
  parameters:
    comment: Stage 5 manual source ICRS declination, decimal degrees.
    entry_signal: editingFinished
    gui_hint: ''
    label: Manual Dec (deg)
    type: string
    value: '-30.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1560, 1408.0]
    enabled: true
    rotation: 0
    state: enabled
- name: manual_ra_hours
  id: variable_qtgui_entry
  parameters:
    comment: Stage 5 manual source ICRS right ascension, decimal hours.
    entry_signal: editingFinished
    gui_hint: ''
    label: Manual RA (h)
    type: string
    value: '5.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1208, 1432.0]
    enabled: true
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: Target B210 sample rate per RX channel.
    value: 30.72e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1208, 1568.0]
    enabled: true
    rotation: 0
    state: enabled
- name: site_height_m
  id: variable
  parameters:
    comment: Stage 5 observing site height above ellipsoid/metres, initial value.
    value: '70'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [352, 1792.0]
    enabled: true
    rotation: 0
    state: enabled
- name: site_lat_deg
  id: variable
  parameters:
    comment: Stage 5 observing site latitude, degrees north positive.
    value: '-32.724'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [352, 1568.0]
    enabled: true
    rotation: 0
    state: enabled
- name: site_lon_deg
  id: variable
  parameters:
    comment: Stage 5 observing site longitude, degrees east positive.
    value: '+152.130167'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [352, 1688.0]
    enabled: true
    rotation: 0
    state: enabled
- name: sky_axis_start
  id: variable
  parameters:
    comment: Left edge of shifted FFT display in sky Hz. High-side conversion reverses
      IF frequency.
    value: lnb_lo-(if_cf-samp_rate/2)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [776, 1296.0]
    enabled: true
    rotation: 0
    state: enabled
- name: sky_axis_step
  id: variable
  parameters:
    comment: Negative display bin step maps increasing IF bins to decreasing sky frequency.
    value: -samp_rate/fft_size
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [776, 1200.0]
    enabled: true
    rotation: 0
    state: enabled
- name: sky_cf
  id: variable
  parameters:
    comment: Nominal astronomical sky centre frequency, Hz.
    value: 4.800e9
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [352, 1216.0]
    enabled: true
    rotation: 0
    state: enabled
- name: source_mode
  id: variable_qtgui_chooser
  parameters:
    comment: 'Stage 5 source selector: 0=Sun, 1=Manual ICRS RA/Dec.'
    gui_hint: ''
    label: Source
    label0: Sun
    label1: Manual RA/Dec
    label2: ''
    label3: ''
    label4: ''
    labels: '[]'
    num_opts: '2'
    option0: '0'
    option1: '1'
    option2: '2'
    option3: '3'
    option4: '4'
    options: '[0, 1]'
    orient: Qt.QHBoxLayout
    type: int
    value: '0'
    widget: combo_box
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [776, 1412.0]
    enabled: true
    rotation: 0
    state: enabled
- name: astronomy_coordinate_engine
  id: epy_block
  parameters:
    _source_code: "import time\n\nimport numpy as np\nfrom gnuradio import gr\n\nfrom astropy import units as u\nfrom astropy.coordinates import AltAz, EarthLocation, SkyCoord, TETE, get_sun\nfrom astropy.time import Time\nfrom astropy.utils import iers\n\niers.conf.auto_download = False\niers.conf.iers_degraded_accuracy = 'warn'\n\n\nclass blk(gr.sync_block):\n    \"\"\"Stage 5 source/site/time astronomy-coordinate engine.\"\"\"\n\n    def __init__(\n        self,\n        fft_size=4096,\n        site_lat_deg=-32.724,\n        site_lon_deg=152.130167,\n        site_height_m=70.0,\n        source_mode=0,\n        manual_ra_hours=5.0,\n        manual_dec_deg=-30.0,\n    ):\n        self.fft_size = int(fft_size)\n        self.site_lat_deg = float(site_lat_deg)\n        self.site_lon_deg = float(site_lon_deg)\n        self.site_height_m = float(site_height_m)\n        self.source_mode = int(source_mode)\n        self.manual_ra_hours = float(manual_ra_hours)\n        self.manual_dec_deg = float(manual_dec_deg)\n        self._last_update = 0.0\n        self._cache = np.full(7, np.nan, dtype=np.float32)\n        gr.sync_block.__init__(\n            self,\n            name='Astronomy Coordinate Engine',\n            in_sig=[(np.complex64, self.fft_size)],\n            out_sig=[\n                np.float32,\n                np.float32,\n                np.float32,\n                np.float32,\n                np.float32,\n                np.float32,\n                np.float32,\n            ],\n        )\n\n    def _invalidate(self):\n        self._last_update = 0.0\n\n    def set_site_lat_deg(self, value):\n        self.site_lat_deg = float(value)\n        self._invalidate()\n\n    def set_site_lon_deg(self, value):\n        self.site_lon_deg = float(value)\n        self._invalidate()\n\n    def set_site_height_m(self, value):\n        self.site_height_m = float(value)\n        self._invalidate()\n\n    def set_source_mode(self, value):\n        self.source_mode = int(value)\n        self._invalidate()\n\n    def set_manual_ra_hours(self, value):\n        self.manual_ra_hours = float(value)\n        self._invalidate()\n\n    def set_manual_dec_deg(self, value):\n        self.manual_dec_deg = float(value)\n        self._invalidate()\n\n    def _compute(self):\n        site_lat_deg = float(self.site_lat_deg)\n        site_lon_deg = float(self.site_lon_deg)\n        site_height_m = float(self.site_height_m)\n        source_mode = int(self.source_mode)\n        manual_ra_hours = float(self.manual_ra_hours)\n        manual_dec_deg = float(self.manual_dec_deg)\n\n        location = EarthLocation(\n            lat=site_lat_deg * u.deg,\n            lon=site_lon_deg * u.deg,\n            height=site_height_m * u.m,\n        )\n        obstime = Time.now()\n        obstime.location = location\n\n        if source_mode == 0:\n            source_coord = get_sun(obstime)\n        else:\n            source_coord = SkyCoord(\n                ra=manual_ra_hours * u.hourangle,\n                dec=manual_dec_deg * u.deg,\n                frame='icrs',\n            )\n\n        apparent = source_coord.transform_to(TETE(obstime=obstime, location=location))\n        altaz = source_coord.transform_to(\n            AltAz(obstime=obstime, location=location, pressure=0 * u.hPa)\n        )\n\n        utc_dt = obstime.utc.datetime\n        utc_hour = (\n            utc_dt.hour\n            + utc_dt.minute / 60.0\n            + (utc_dt.second + utc_dt.microsecond * 1e-6) / 3600.0\n        )\n        lmst_hour = (\n            obstime.sidereal_time('apparent', longitude=site_lon_deg * u.deg).hour\n            % 24.0\n        )\n        apparent_ra_hour = apparent.ra.hour % 24.0\n        apparent_dec_deg = apparent.dec.deg\n        ha_hour = ((lmst_hour - apparent_ra_hour + 12.0) % 24.0) - 12.0\n\n        self._cache = np.array(\n            [\n                utc_hour,\n                lmst_hour,\n                ha_hour,\n                altaz.az.deg % 360.0,\n                altaz.alt.deg,\n                apparent_ra_hour,\n                apparent_dec_deg,\n            ],\n            dtype=np.float32,\n        )\n        self._last_update = time.monotonic()\n\n    def work(self, input_items, output_items):\n        nout = len(input_items[0])\n        if nout == 0:\n            return 0\n\n        if self._last_update == 0.0 or time.monotonic() - self._last_update >= 1.0:\n            try:\n                self._compute()\n            except Exception as exc:\n                print(f\"Stage 5 astronomy error: {exc}\", flush=True)\n                self._cache = np.full(7, np.nan, dtype=np.float32)\n                self._last_update = time.monotonic()\n\n        for idx, value in enumerate(self._cache):\n            output_items[idx][:nout] = value\n\n        return nout\n"
    affinity: ''
    alias: ''
    comment: 'Stage 5 only: low-rate Astropy source/site/time coordinates after cross_accum.
      Does not correct C01.'
    fft_size: fft_size
    manual_dec_deg: manual_dec_deg
    manual_ra_hours: manual_ra_hours
    maxoutbuf: '0'
    minoutbuf: '0'
    site_height_m: site_height_m
    site_lat_deg: site_lat_deg
    site_lon_deg: site_lon_deg
    source_mode: source_mode
  states:
    _io_cache: ('Astronomy Coordinate Engine', 'blk', [('fft_size', '4096'), ('site_lat_deg',
      '-32.724'), ('site_lon_deg', '152.130167'), ('site_height_m', '0.0'), ('source_mode',
      '0'), ('manual_ra_hours', '5.0'), ('manual_dec_deg', '-30.0')], [('0', 'complex',
      4096)], [('0', 'float', 1), ('1', 'float', 1), ('2', 'float', 1), ('3', 'float',
      1), ('4', 'float', 1), ('5', 'float', 1), ('6', 'float', 1)], 'Stage 5 source/site/time
      astronomy-coordinate engine.', ['fft_size', 'manual_dec_deg', 'manual_ra_hours',
      'site_height_m', 'site_lat_deg', 'site_lon_deg', 'source_mode'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2472, 672.0]
    enabled: true
    rotation: 0
    state: enabled
