- name: phase_slope_delay_estimator
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n\
      \    \"\"\"Stage 4 phase-slope / differential-delay estimator.\n\n    Fits unwrapped\
      \ C01 phase against increasing B210 baseband/IF\n    frequency. Cross-spectrum\
      \ convention is C01 = X0 * conj(X1).\n    Provisional sign convention: positive\
      \ RX1 delay relative to RX0\n    should produce positive phase slope versus\
      \ increasing IF/baseband\n    frequency and positive reported differential delay.\n\
      \    \"\"\"\n\n    def __init__(self, fft_size=4096, samp_rate=30.72e6):\n \
      \       self.fft_size = int(fft_size)\n        self.samp_rate = float(samp_rate)\n\
      \        gr.sync_block.__init__(\n            self,\n            name='Phase\
      \ Slope / Delay Estimator',\n            in_sig=[(np.complex64, self.fft_size)],\n\
      \            out_sig=[np.float32, np.float32, np.float32],\n        )\n    \
      \    self._f = (\n            (np.arange(self.fft_size, dtype=np.float64) -\
      \ self.fft_size / 2.0)\n            * self.samp_rate\n            / self.fft_size\n\
      \        )\n\n    def work(self, input_items, output_items):\n        spectra\
      \ = input_items[0]\n        delay_ns = output_items[0]\n        slope_deg_per_mhz\
      \ = output_items[1]\n        fit_rms_deg = output_items[2]\n\n        for i,\
      \ c01 in enumerate(spectra):\n            phase = np.angle(c01)\n          \
      \  phase_unwrapped = np.unwrap(phase).astype(np.float64)\n            slope,\
      \ intercept = np.polyfit(self._f, phase_unwrapped, 1)\n            phase_fit\
      \ = slope * self._f + intercept\n            residual = phase_unwrapped - phase_fit\n\
      \n            delay_ns[i] = np.float32((slope / (2.0 * np.pi)) * 1e9)\n    \
      \        slope_deg_per_mhz[i] = np.float32(slope * (180.0 / np.pi) * 1e6)\n\
      \            fit_rms_deg[i] = np.float32(\n                np.sqrt(np.mean(residual\
      \ * residual)) * (180.0 / np.pi)\n            )\n\n        return len(spectra)\n"
    affinity: ''
    alias: ''
    comment: 'Stage 4 only: low-rate estimator after cross_accum. Fits against increasing
      baseband/IF frequency, not displayed sky frequency.'
    fft_size: fft_size
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
  states:
    _io_cache: '(''Phase Slope / Delay Estimator'', ''blk'', [(''fft_size'', ''4096''),
      (''samp_rate'', ''30720000.0'')], [(''0'', ''complex'', 4096)], [(''0'', ''float'',
      1), (''1'', ''float'', 1), (''2'', ''float'', 1)], ''Stage 4 phase-slope / differential-delay
      estimator.\n\n    Fits unwrapped C01 phase against increasing B210 baseband/IF\n    frequency.
      Cross-spectrum convention is C01 = X0 * conj(X1).\n    Provisional sign convention:
      positive RX1 delay relative to RX0\n    should produce positive phase slope
      versus increasing IF/baseband\n    frequency and positive reported differential
      delay.\n    '', [''fft_size'', ''samp_rate''])'
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2488, 464.0]
    enabled: true
    rotation: 0
    state: enabled
