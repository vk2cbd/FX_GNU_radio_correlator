    bus_structure: null
    coordinate: [1384, 624.0]
    enabled: true
    rotation: 0
    state: enabled
- name: fft_rate
  id: variable
  parameters:
    comment: 'At defaults: 30.72e6/4096 = 7500 FFT vectors/s.'
