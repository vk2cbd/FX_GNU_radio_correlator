options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: 'Stage 10 FX interferometer flowgraph. RX0=Antenna 0 / 2.4 m, RX1=Antenna
      1 / 1.7 m. Cross-spectrum convention: C01[k] = X0[k] * conj(X1[k]). High-side
      LNB sky axis uses x_start=lnb_lo-(if_cf-samp_rate/2), x_step=-samp_rate/fft_size.'
    copyright: ''
    description: Minimal two-channel B210 FX correlator commissioning flowgraph.
    gen_cmake: 'Off'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: fx_interferometer_v1_stage10
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: FX Interferometer V1 Stage 10
    window_size: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [56, 80.0]
    enabled: true
    rotation: 0
    state: enabled

blocks:
- name: accum_frames
  id: variable
  parameters:
    comment: 'At defaults: round(7500*0.1) = 750 FFT vectors.'
    value: int(round(fft_rate*accum_time))
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1552, 1200.0]
    enabled: true
    rotation: 0
    state: enabled
- name: accum_time
  id: variable
  parameters:
    comment: First-stage accumulation time in seconds.
    value: '0.1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [776, 1632.0]
    enabled: true
    rotation: 0
    state: enabled
- name: fft_rate
  id: variable
  parameters:
    comment: 'At defaults: 30.72e6/4096 = 7500 FFT vectors/s.'
    value: samp_rate/fft_size
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1560, 1304.0]
    enabled: true
    rotation: 0
    state: enabled
- name: fft_size
  id: variable
  parameters:
    comment: Default FFT length. Stage 1-3 default is 4096.
    value: '4096'
  states:
